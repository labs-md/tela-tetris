      "html": "<button class=\"ds-primary\">Revisar pedido<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font:500 12px/1.6 var(--sans,Inter,system-ui,sans-serif);transition:background-color .15s,color .15s,border-color .15s;display:flex;align-items:center;justify-content:space-between;gap:22px;min-width:180px;min-height:46px;padding:12px 14px;border:1px solid transparent;border-radius:6px;background:var(--yellow,#e8fb5b);color:var(--text,#1c1c1b);font-size:13px;cursor:pointer}.ds-primary svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5}.ds-primary:hover:enabled{background:#dced4d}.ds-primary:active:enabled{border-color:var(--text,#1c1c1b)}.ds-primary:focus-visible{outline:2px solid var(--focus,#59651b);outline-offset:4px;}.ds-primary:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}",
