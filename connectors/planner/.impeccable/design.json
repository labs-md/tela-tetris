      "css": ".ds-download{font:500 12px/1.6 var(--sans,Inter,system-ui,sans-serif);transition:background-color .15s,color .15s,border-color .15s;display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:42px;padding:10px 6px;border:1px solid #b6bfab;border-radius:6px;background:var(--panel,#ffffff);color:var(--text,#1c1c1b);cursor:pointer}.ds-download svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5}.ds-download:hover{background:var(--raised,#f1f3ee)}.ds-download:focus-visible{outline:2px solid var(--focus,#59651b);outline-offset:4px;}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}",
