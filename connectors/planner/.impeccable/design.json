      "css": ".ds-stepper{display:flex;height:46px}.ds-stepper button{font:500 12px/1.6 var(--sans,Inter,system-ui,sans-serif);transition:background-color .15s,color .15s,border-color .15s;flex:0 0 32px;padding:0;border:1px solid var(--control-line,#cbd1c5);background:var(--bg,#f7f8f6);color:var(--text,#1c1c1b);font-size:18px;line-height:1;cursor:pointer}.ds-stepper button:first-child{border-radius:5px 0 0 5px}.ds-stepper button:last-child{border-radius:0 5px 5px 0}.ds-stepper input{font:500 12px/1.6 var(--sans,Inter,system-ui,sans-serif);transition:background-color .15s,color .15s,border-color .15s;min-width:0;width:100%;max-width:none;border:0;border-block:1px solid var(--control-line,#cbd1c5);border-radius:0;background:var(--panel,#ffffff);color:var(--text,#1c1c1b);text-align:center;font-variant-numeric:tabular-nums;appearance:textfield}.ds-stepper input::-webkit-inner-spin-button,.ds-stepper input::-webkit-outer-spin-button{appearance:none;margin:0}.ds-stepper button:hover:enabled{background:var(--yellow,#e8fb5b);border-color:var(--control-hover-line,#8b9582)}.ds-stepper button:focus-visible,.ds-stepper input:focus-visible{outline:2px solid var(--focus,#59651b);outline-offset:4px;}.ds-stepper button:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}.ds-garment-sizes{font:500 14px/1.6 var(--sans,Inter,system-ui,sans-serif);color:var(--text,#1c1c1b)}.ds-garment-group{margin:0;padding:0;border:0;min-width:0}.ds-garment-group+.ds-garment-group{margin-top:28px}.ds-garment-group+.ds-garment-group::before{content:\"\";display:block;border-top:1px solid var(--line,#dfe3db);margin-bottom:24px}.ds-garment-group legend{padding:0;font-size:18px}.ds-garment-description{font-size:12px;color:var(--muted,#60655c);margin:5px 0 0}.ds-sizes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px;margin-top:16px}.ds-size-row{min-width:0}.ds-size-name{display:block;font-size:12px;margin-bottom:6px;color:var(--muted,#60655c)}.ds-patterns{margin-top:16px}.ds-patterns summary{cursor:pointer;font-size:13px;width:fit-content}.ds-patterns summary:focus-visible{outline:2px solid var(--focus,#59651b);outline-offset:4px}.ds-patterns summary:hover{color:var(--muted,#60655c)}.ds-piece-bank{display:grid;grid-template-columns:repeat(5,1fr);gap:22px;margin-top:22px}.ds-piece-sample{min-width:0}.ds-piece-sample svg{width:100%;max-width:115px;height:72px;margin:0 auto 14px;overflow:visible}.ds-piece-sample p,.ds-piece-sample small{display:block;font-size:12px;text-align:center;margin:0}.ds-piece-sample small{color:var(--muted,#60655c);margin-top:4px}.ds-stepper input[aria-invalid=true]{border-color:#a93600;background:#fff4ed}@media(max-width:1150px){.ds-sizes{gap:10px}}@media(max-width:760px){.ds-sizes{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 20px}.ds-garment-group legend{font-size:17px}.ds-piece-bank{grid-template-columns:repeat(3,minmax(0,1fr));gap:23px 14px}.ds-piece-sample p,.ds-piece-sample small{overflow-wrap:anywhere}}",
      "refersTo": "input-quantity"
    },
    {
      "name": "Prenda seleccionada",
      "kind": "button",
      "description": "Tarjeta de selección múltiple independiente con aria-pressed y casilla SVG marcada; vertical en escritorio y horizontal en móvil.",
      "html": "<button type=\"button\" class=\"ds-preset\" aria-pressed=\"true\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><path d=\"M18 5h8c2 8 10 8 12 0h8l15 13-9 14-9-6v33H21V26l-9 6-9-14Z\"/></svg><span><strong>Playeras</strong><small>Manga corta · con bolsillo</small></span><svg class=\"ds-preset-check\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><rect x=\"2\" y=\"2\" width=\"16\" height=\"16\" rx=\"3\"/><path d=\"m6 10 3 3 5-6\"/></svg></button>",
      "css": ".ds-preset{font:500 14px/1.6 var(--sans,Inter,system-ui,sans-serif);transition:background-color .15s,color .15s,border-color .15s;display:flex;flex-direction:column;align-items:start;text-align:left;gap:24px;min-height:220px;padding:28px;border:1px solid var(--control-line,#cbd1c5);border-radius:6px;background:var(--panel,#ffffff);color:var(--text,#1c1c1b);cursor:pointer}.ds-preset svg{width:64px;height:74px;fill:none;stroke:#737b69;stroke-width:1.7;stroke-linejoin:round;flex-shrink:0}.ds-preset strong{display:block;font-size:16px;font-weight:500}.ds-preset small{display:block;margin-top:3px;color:var(--muted,#60655c);font-size:13px;line-height:1.45}.ds-preset:hover{background:var(--bg,#f7f8f6);border-color:var(--control-hover-line,#8b9582)}.ds-preset[aria-pressed=true]{background:var(--selected,#f7fbdc);border-color:#828e3c}.ds-preset[aria-pressed=true] svg{stroke:var(--text,#1c1c1b)}.ds-preset:focus-visible{outline:2px solid var(--focus,#59651b);outline-offset:4px}@media(max-width:760px){.ds-preset{flex-direction:row;align-items:center;padding:20px;gap:22px;min-height:115px}.ds-preset svg{height:58px;width:52px}.ds-preset strong{font-size:15px}}@media(prefers-reduced-motion:reduce){.ds-preset{transition:none}}.ds-preset{position:relative}.ds-preset .ds-preset-check{position:absolute;top:18px;right:18px;width:22px;height:22px;stroke:#737b69;stroke-width:1.5;fill:white}.ds-preset[aria-pressed=true] .ds-preset-check{stroke:var(--text,#1c1c1b);fill:var(--yellow,#e8fb5b)}@media(max-width:760px){.ds-preset{padding-right:44px}.ds-preset .ds-preset-check{width:20px;height:20px;top:15px;right:12px}}",
      "refersTo": "preset-selected"
    },
    {
      "name": "Panel blanco",
      "kind": "card",
      "description": "Panel del asistente con cuerpo amplio y pie de acciones separado por una regla.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-body\"><h2>Tu pedido</h2><p>Revisa las prendas y las condiciones antes de calcular.</p></div><div class=\"ds-panel-footer\">Paso 3 de 4</div></section>",
      "css": ".ds-panel{font:500 12px/1.6 var(--sans,Inter,system-ui,sans-serif);background:var(--panel,#ffffff);color:var(--text,#1c1c1b);border:1px solid var(--line,#dfe3db);border-radius:10px}.ds-panel-body{padding:32px}.ds-panel h2{margin:0;font-size:16px;font-weight:500;line-height:1.5}.ds-panel p{margin:8px 0 0;color:var(--muted,#60655c)}.ds-panel-footer{padding:20px 32px;border-top:1px solid var(--line,#dfe3db);color:var(--muted,#60655c)}@media(max-width:760px){.ds-panel-body{padding:22px}.ds-panel-footer{padding:18px 22px}}",
      "refersTo": "panel"
    },
    {
      "name": "Ruta del asistente",
      "kind": "nav",
      "description": "Cuatro pasos con círculo amarillo activo, regla inferior y estados completados y futuros. Editar una fila lleva al grupo de tallas y enfoca su primer campo.",
      "html": "<nav class=\"ds-progress\" aria-label=\"Pasos del planificador\"><ol><li><button class=\"ds-completed\" type=\"button\"><span class=\"ds-step-number\">1</span><span>Prendas</span></button></li><li><button type=\"button\" aria-current=\"step\"><span class=\"ds-step-number\">2</span><span>Tallas</span></button></li><li><button type=\"button\" disabled><span class=\"ds-step-number\">3</span><span>Revisión</span></button></li><li><button type=\"button\" disabled><span class=\"ds-step-number\">4</span><span>Tu tela</span></button></li></ol></nav>",
      "css": ".ds-progress{font:500 13px/1.6 var(--sans,Inter,system-ui,sans-serif)}.ds-progress ol{display:grid;grid-template-columns:repeat(4,1fr);padding:0;margin:0;list-style:none;gap:8px}.ds-progress li{min-width:0}.ds-progress button{font:inherit;display:flex;align-items:center;gap:10px;border:0;border-radius:0;background:transparent;width:100%;padding:12px 0;color:var(--muted,#60655c);border-bottom:2px solid var(--line,#dfe3db);cursor:pointer;transition:background-color .15s,color .15s,border-color .15s}.ds-progress button:disabled{opacity:1;color:#747c6e;cursor:default}.ds-progress button[aria-current]{color:var(--text,#1c1c1b);border-bottom-color:#7c872c}.ds-step-number{display:inline-grid;place-items:center;border:1px solid #bac2b2;width:27px;height:27px;border-radius:50%;font-size:12px}.ds-progress [aria-current] .ds-step-number{background:var(--yellow,#e8fb5b);color:var(--text,#1c1c1b);border-color:var(--yellow,#e8fb5b)}.ds-progress .ds-completed .ds-step-number{background:var(--raised,#f1f3ee);color:var(--text,#1c1c1b)}.ds-progress button:hover:enabled{color:var(--text,#1c1c1b)}.ds-progress button:focus-visible{outline:2px solid var(--focus,#59651b);outline-offset:4px}@media(max-width:760px){.ds-progress button{flex-direction:column;gap:8px;align-items:start;font-size:12px;padding:8px 0 12px}.ds-step-number{width:24px;height:24px}}@media(prefers-reduced-motion:reduce){.ds-progress button{transition:none}}"
    },
    {
      "name": "Estado del tendido",
      "kind": "chip",
      "description": "Estado informativo del cálculo.",
      "html": "<span class=\"ds-status\">Tendido listo</span>",
      "css": ".ds-status{font:500 12px/1.6 var(--sans,Inter,system-ui,sans-serif);display:inline-block;padding:4px 8px;border-radius:4px;background:var(--selected,#f7fbdc);color:var(--text,#1c1c1b)}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}",
      "refersTo": "status-complete"
    },
    {
      "name": "Compra recomendada",
      "kind": "card",
      "description": "Compra blanca con cifra Inter y unidades.",
      "html": "<section class=\"ds-purchase\"><h2>Compra recomendada</h2><p class=\"ds-value\"><strong>2.75</strong><span>yardas</span></p><p class=\"ds-unit\">de tela de <b>150 cm de ancho</b></p><div class=\"ds-detail\"><span>Tela aprovechada</span><span>78.9 %</span></div></section>",
      "css": ".ds-purchase{font:500 12px/1.6 var(--sans,Inter,system-ui,sans-serif);padding:22px;border:1px solid var(--line,#dfe3db);border-radius:10px;background:var(--panel,#ffffff);color:var(--text,#1c1c1b)}.ds-purchase h2{margin:0;font-size:16px;font-weight:500;line-height:1.5}.ds-value{display:flex;align-items:baseline;gap:9px;margin:18px 0 6px}.ds-value strong{font-size:42px;font-weight:500;line-height:1.15;letter-spacing:-.035em;font-variant-numeric:tabular-nums}.ds-value span{font-size:15px}.ds-unit{margin:0;color:var(--muted,#60655c)}.ds-unit b{font-weight:500;color:var(--text,#1c1c1b)}.ds-detail{display:flex;justify-content:space-between;gap:12px;margin-top:22px;padding:17px 0;border-block:1px solid var(--line,#dfe3db)}.ds-detail span:first-child{color:var(--muted,#60655c)}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Acción secundaria",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Volver, cambiar las prendas seleccionadas o comenzar un nuevo pedido.",
      "html": "<button class=\"ds-secondary\" type=\"button\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 3v14M3 10h14\"/></svg>Cambiar prendas</button>",
      "css": ".ds-secondary{font:500 13px/1.6 var(--sans,Inter,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:9px;background:var(--panel,#ffffff);color:var(--text,#1c1c1b);border:1px solid #b6bfab;border-radius:6px;min-height:44px;padding:10px 16px;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s}.ds-secondary svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-secondary:hover:enabled{background:var(--raised,#f1f3ee)}.ds-secondary:focus-visible{outline:2px solid var(--focus,#59651b);outline-offset:4px}.ds-secondary:disabled{opacity:.45;cursor:default}@media(max-width:760px){.ds-secondary{padding-inline:12px}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "La mesa de corte",
    "overview": "El planificador guía una decisión a la vez con pasos numerados, paneles blancos y reglas finas sobre un fondo gris verdoso. Neuton identifica la herramienta; Inter permite comparar cantidades, medidas y unidades. El amarillo de LABS destaca la acción y la selección; el naranja señala el final medido del rollo y las piezas que lo usan en el preset.\n\nEste sistema rige únicamente `connectors/planner`. Conserva la identidad profesional clara de LABS y registra el asistente construido en `planner.css`, `index.html` y `planner.js`. La selección, las cantidades, la revisión y el resultado comparten la misma tipografía y los mismos controles; la ruta visible y el pie de acciones permiten volver sin perder el pedido.",
    "keyCharacteristics": [
      "Paneles blancos planos, bordes finos y esquinas discretas.",
      "Neuton en título y marca; Inter en información, controles y compra.",
      "Amarillo para acción, paso activo y selección, con naranja en la geometría del tendido.",
      "Una tarea visible por paso, con acciones en un pie común.",
      "Geometría y colores del preset compartidos por muestras, tendido y descarga."
    ],
    "rules": [
      {
        "name": "The Accent Purpose Rule",
        "body": "El amarillo destaca la acción principal y los estados activos; los paneles de compra permanecen blancos. El naranja del tendido señala el extremo medido del rollo.",
        "section": "colors"
      },
      {
        "name": "The Color Continuity Rule",
        "body": "Cada tipo de pieza conserva su color en la muestra, el tendido y la descarga; el color identifica geometría, no una valoración de calidad.",
        "section": "colors"
      },
      {
        "name": "The Measured Label Rule",
        "body": "El canvas comprueba el espacio disponible antes de mostrar nombre y talla; omite la etiqueta cuando no cabe y conserva la geometría.",
        "section": "typography"
      },
      {
        "name": "The Flat Sections Rule",
        "body": "Los paneles se distinguen por fondo, borde, espacio y tipografía, sin sombras.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do conservar Neuton para título y marca e Inter para controles, medidas y compra.",
      "Do mantener visibles las unidades y las advertencias sobre patrones ilustrativos.",
      "Do conservar el color y la geometría de cada pieza entre las distintas representaciones.",
      "Do mantener el desplazamiento horizontal del rollo dentro de su contenedor.",
      "Do dar foco visible y respetar la preferencia de movimiento reducido.",
      "Do mantener la ruta numerada, una tarea por paso y las acciones en el pie del panel.",
      "Do conservar las cantidades al volver y deshabilitar el avance si el pedido no es válido.",
      "Do mantener visibles todos los grupos seleccionados en Tallas, con campos únicos y patrones propios.",
      "Do validar el pedido completo, con al menos una unidad por tipo seleccionado y un máximo global de 12 prendas.",
      "Do mostrar casillas marcadas y `aria-pressed` independientes para la selección múltiple."
    ],
    "donts": [
      "Don't trasladar fuentes pixeladas, biseles, cuenta regresiva ni composición de juego al planificador.",
      "Don't convertir el tendido en un escenario oscuro ni la compra en un panel amarillo.",
      "Don't sustituir las piezas calculadas por diagramas decorativos.",
      "Don't añadir sombras para jerarquizar paneles planos.",
      "Don't reducir las etiquetas del rollo para forzarlas dentro de una pieza pequeña."
    ]
  }
}
