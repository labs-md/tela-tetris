      "html": "<button class=\"ds-preset\" aria-pressed=\"true\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><path d=\"M18 5h8c2 8 10 8 12 0h8l15 13-9 14-9-6v33H21V26l-9 6-9-14Z\"/></svg><span><strong>Playeras</strong><small>Manga corta · con bolsillo</small></span></button>",
      "css": ".ds-preset{font:500 14px/1.6 var(--sans,Inter,system-ui,sans-serif);transition:background-color .15s,color .15s,border-color .15s;display:flex;flex-direction:column;align-items:start;text-align:left;gap:24px;min-height:220px;padding:28px;border:1px solid var(--control-line,#cbd1c5);border-radius:6px;background:var(--panel,#ffffff);color:var(--text,#1c1c1b);cursor:pointer}.ds-preset svg{width:64px;height:74px;fill:none;stroke:#737b69;stroke-width:1.7;stroke-linejoin:round;flex-shrink:0}.ds-preset strong{display:block;font-size:16px;font-weight:500}.ds-preset small{display:block;margin-top:3px;color:var(--muted,#60655c);font-size:13px;line-height:1.45}.ds-preset:hover{background:var(--bg,#f7f8f6);border-color:var(--control-hover-line,#8b9582)}.ds-preset[aria-pressed=true]{background:var(--selected,#f7fbdc);border-color:#828e3c}.ds-preset[aria-pressed=true] svg{stroke:var(--text,#1c1c1b)}.ds-preset:focus-visible{outline:2px solid var(--focus,#59651b);outline-offset:4px}@media(max-width:760px){.ds-preset{flex-direction:row;align-items:center;padding:20px;gap:22px;min-height:115px}.ds-preset svg{height:58px;width:52px}.ds-preset strong{font-size:15px}}@media(prefers-reduced-motion:reduce){.ds-preset{transition:none}}",
